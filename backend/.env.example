# ====================================================================
# FormNest Backend Environment Variables
# Copy to .env and fill real values. Zod validates these on boot.
# ====================================================================

# Node Environment: development | test | production
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string (managed Neon/RDS in prod)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formnest

# Redis (Upstash in prod). Used for rate-limit, BullMQ, idempotency, counters.
REDIS_URL=redis://localhost:6379

# JWT — HS256 in MVP; rotate periodically. Refresh tokens stored hashed in DB.
JWT_SECRET=replace-with-64-char-random-string-min-32-bytes-entropy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth security
BCRYPT_SALT_ROUNDS=12
API_KEY_PEPPER=replace-with-32-char-random-pepper
WEBHOOK_HMAC_SECRET=replace-with-32-char-random-string

# SMTP / Email provider (Resend / Postmark / Mailgun via SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxx
FROM_EMAIL=no-reply@formnest.com
FROM_NAME=FormNest

# Public URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File upload limits (bytes)
MAX_FILE_SIZE_FREE=5242880
MAX_FILE_SIZE_PRO=52428800

# S3 / R2 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=formnest
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/formnest

# Stripe billing
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx

# Observability
SENTRY_DSN=
