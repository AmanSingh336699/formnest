# ========================================================
# FormNest Backend Environment Variables Template
# Copy to .env and fill real values. Zod validates these on boot.
# ========================================================

# Node Environment: development | test | production
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/formnest

# Redis connection string
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=replace-with-64-char-random-string-min-32-bytes-entropy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Auth security
BCRYPT_SALT_ROUNDS=12
API_KEY_PEPPER=replace-with-32-char-random-pepper
WEBHOOK_HMAC_SECRET=replace-with-32-char-random-string

# Admin Seed Credentials (required when running drizzle/seed.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-to-a-secure-admin-password

# SMTP / Email provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
FROM_NAME=FormNest

# Google API OAuth2 Credentials for Gmail HTTP API (Optional fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Public URLs
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File upload limits (bytes)
MAX_FILE_SIZE_FREE=5242880
MAX_FILE_SIZE_PRO=52428800

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx

# Observability
SENTRY_DSN=
