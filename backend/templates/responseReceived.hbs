<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>New response received · FormNest</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(145deg, #F1F5F9 0%, #E8EEF5 100%);
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
      line-height: 1.5;
      padding: 2rem 1rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* modern email card */
    .response-card {
      max-width: 620px;
      width: 100%;
      margin: 0 auto;
      background: #FFFFFF;
      border-radius: 2rem;
      box-shadow: 0 25px 48px -12px rgba(0, 0, 0, 0.25), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
      overflow: hidden;
      transition: transform 0.2s;
      animation: fadeSlideUp 0.45s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
    }

    .card-content {
      padding: 2.5rem 2rem;
    }

    /* brand header */
    .brand-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
      padding-bottom: 12px;
      border-bottom: 2px solid #F0F4FA;
    }

    .logo-badge {
      background: #4F46E5;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 1.25rem;
      box-shadow: 0 12px 18px -8px rgba(79, 70, 229, 0.3);
    }

    .logo-badge svg {
      width: 26px;
      height: 26px;
      color: white;
    }

    .brand-text h2 {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #0F172A, #1E2A44);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .brand-text p {
      font-size: 0.7rem;
      font-weight: 500;
      color: #5B6E8C;
      letter-spacing: 0.3px;
    }

    /* notification badge */
    .notification-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #EEF2FF;
      padding: 6px 16px;
      border-radius: 40px;
      margin-bottom: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #4F46E5;
    }

    /* main heading */
    .main-heading {
      font-size: 1.9rem;
      font-weight: 800;
      line-height: 1.2;
      color: #0A0F1C;
      margin: 0.25rem 0 0.25rem;
      letter-spacing: -0.3px;
    }

    .form-title {
      background: linear-gradient(120deg, #EFF6FF, #E0E7FF);
      display: inline-block;
      padding: 0.1rem 0.6rem;
      border-radius: 40px;
      font-weight: 700;
      color: #1E40AF;
    }

    .intro-text {
      font-size: 1rem;
      color: #2C3E4E;
      margin: 1rem 0 0.5rem 0;
    }

    /* response summary card */
    .response-preview {
      background: #F9FCFF;
      border-radius: 1.25rem;
      border: 1px solid #E9F0F8;
      margin: 1.5rem 0 1rem;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .preview-header {
      background: #F1F5F9;
      padding: 0.8rem 1.2rem;
      font-weight: 700;
      font-size: 0.8rem;
      color: #1E293B;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid #E2E8F0;
    }

    .preview-body {
      padding: 1rem 1.2rem;
    }

    .response-field {
      margin-bottom: 0.9rem;
      font-size: 0.85rem;
    }

    .field-label {
      font-weight: 700;
      color: #4B5563;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .field-value {
      color: #0F172A;
      background: #FFFFFF;
      padding: 0.4rem 0.7rem;
      border-radius: 12px;
      border: 1px solid #E9EEF5;
      word-break: break-word;
      font-size: 0.85rem;
      margin-top: 4px;
    }

    /* note for multiple fields */
    .more-fields-note {
      font-size: 0.7rem;
      color: #6C7A92;
      margin-top: 10px;
      text-align: right;
      border-top: 1px dashed #E2E8F0;
      padding-top: 10px;
    }

    /* CTA button */
    .btn-wrapper {
      margin: 1.75rem 0 1.5rem;
    }

    .view-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: linear-gradient(105deg, #4F46E5 0%, #6366F1 100%);
      color: white;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.85rem 2.2rem;
      border-radius: 60px;
      text-decoration: none;
      box-shadow: 0 12px 20px -12px rgba(79, 70, 229, 0.4);
      transition: all 0.25s ease;
    }

    .view-btn:hover {
      background: linear-gradient(105deg, #3C37B0 0%, #4F46E5 100%);
      transform: translateY(-2px);
      box-shadow: 0 16px 26px -10px rgba(79, 70, 229, 0.5);
    }

    .view-btn:active {
      transform: translateY(1px);
    }

    /* fallback link */
    .link-container {
      background: #F8FAFE;
      border-radius: 1.25rem;
      padding: 1rem 1.2rem;
      margin: 1rem 0 1.25rem;
      border: 1px solid #E9EDF2;
    }

    .link-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #5B6E8C;
      letter-spacing: 0.4px;
      margin-bottom: 8px;
    }

    .link-value {
      background: white;
      padding: 10px 14px;
      border-radius: 1rem;
      font-size: 0.75rem;
      font-family: 'SF Mono', monospace;
      word-break: break-all;
      border: 1px solid #E2E8F0;
      color: #1F2A44;
    }

    /* timestamp & footer */
    .timestamp {
      font-size: 0.7rem;
      color: #7E8B9C;
      margin: 0.75rem 0 0.5rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .divider-light {
      border: none;
      height: 1px;
      background: linear-gradient(90deg, transparent, #CBD5E1, transparent);
      margin: 1.5rem 0 1rem;
    }

    .footer-note {
      text-align: center;
      font-size: 0.73rem;
      color: #6C7A92;
      line-height: 1.5;
    }

    .footer-note a {
      color: #4F46E5;
      text-decoration: none;
      font-weight: 500;
    }

    /* responsive */
    @media (max-width: 560px) {
      body {
        padding: 1rem;
      }
      .card-content {
        padding: 1.75rem 1.25rem;
      }
      .main-heading {
        font-size: 1.6rem;
      }
      .view-btn {
        width: 100%;
        justify-content: center;
        padding: 0.8rem 1rem;
      }
      .brand-text h2 {
        font-size: 1.45rem;
      }
      .response-field {
        font-size: 0.8rem;
      }
      .preview-body {
        padding: 0.8rem 1rem;
      }
    }

    @media (max-width: 450px) {
      .card-content {
        padding: 1.3rem 1rem;
      }
      .main-heading {
        font-size: 1.4rem;
      }
    }

    @keyframes fadeSlideUp {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
<div class="response-card">
  <div class="card-content">
    
    <!-- brand header with icon -->
    <div class="brand-header">
      <div class="logo-badge">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v5h5" />
        </svg>
      </div>
      <div class="brand-text">
        <h2>FormNest</h2>
        <p>real-time submissions</p>
      </div>
    </div>

    <!-- notification chip -->
    <div class="notification-badge">
      <span>📬</span> NEW RESPONSE
    </div>

    <!-- dynamic heading with form title -->
    <div class="main-heading">
      New response on <span class="form-title">“{{formTitle}}”</span>
    </div>

    <div class="intro-text">
      ✨ You have received a fresh submission. Here's a quick preview:
    </div>

    <!-- dynamic response preview (example fields) -->
    <div class="response-preview">
      <div class="preview-header">
        <span>📋</span> SUBMISSION PREVIEW
      </div>
      <div class="preview-body">
        <!-- These placeholders should be replaced with actual field data from your backend -->
        <div class="response-field">
          <div class="field-label">
            <span>👤</span> Name
          </div>
          <div class="field-value">{{responseName}}</div>
        </div>
        <div class="response-field">
          <div class="field-label">
            <span>✉️</span> Email
          </div>
          <div class="field-value">{{responseEmail}}</div>
        </div>
        <div class="response-field">
          <div class="field-label">
            <span>💬</span> Message
          </div>
          <div class="field-value">{{responseMessage}}</div>
        </div>
        <div class="more-fields-note">
          + {{additionalFieldsCount}} more fields · view full details in dashboard
        </div>
      </div>
    </div>

    <!-- call to action button -->
    <div class="btn-wrapper">
      <a href="{{responseLink}}" class="view-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        View Full Response
      </a>
    </div>

    <!-- fallback link container -->
    <div class="link-container">
      <div class="link-label">
        <span>🔗</span> DIRECT LINK TO RESPONSE
      </div>
      <div class="link-value">
        {{responseLink}}
      </div>
      <div style="font-size: 0.7rem; margin-top: 8px; color: #5F7F9E;">
        If the button doesn't work, copy this link into your browser.
      </div>
    </div>

    <!-- optional timestamp info -->
    <div class="timestamp">
      <span>🕒</span> Received just now · secure & encrypted
    </div>

    <hr class="divider-light">

    <div class="footer-note">
      🛡️ You are receiving this because you're the owner of form “{{formTitle}}”.<br>
      Manage notification preferences in your <a href="#">FormNest dashboard</a>.<br>
      © 2025 FormNest — smarter form management
    </div>

  </div>
</div>
</body>
</html>