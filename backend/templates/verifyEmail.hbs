<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your FormNest verification code</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background: #eef2f7;
      color: #111827;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      line-height: 1.5;
      padding: 32px 16px;
    }

    .email-card {
      max-width: 560px;
      margin: 0 auto;
      overflow: hidden;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid #dde5f0;
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.14);
    }

    .header {
      padding: 28px 30px 20px;
      border-bottom: 1px solid #edf1f7;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #4f46e5;
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 800;
    }

    .brand-name {
      font-size: 19px;
      font-weight: 800;
      color: #111827;
    }

    .brand-copy {
      margin-top: 2px;
      font-size: 13px;
      color: #64748b;
    }

    .content {
      padding: 28px 30px 30px;
    }

    h1 {
      font-size: 24px;
      line-height: 1.25;
      color: #111827;
      margin-bottom: 10px;
    }

    p {
      color: #475569;
      font-size: 15px;
    }

    .otp-box {
      margin: 26px 0 22px;
      padding: 24px;
      border-radius: 16px;
      background: #f8fafc;
      border: 1px solid #dbe4f0;
      text-align: center;
    }

    .otp-label {
      margin-bottom: 10px;
      color: #64748b;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .otp-code {
      color: #312e81;
      font-family: "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
      font-size: 38px;
      font-weight: 800;
      letter-spacing: 0.18em;
    }

    .expiry {
      margin-top: 16px;
      padding: 13px 14px;
      border-radius: 12px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      color: #92400e;
      font-size: 14px;
    }

    .footer {
      border-top: 1px solid #edf1f7;
      padding: 18px 30px 24px;
      color: #64748b;
      font-size: 12px;
    }

    @media (max-width: 520px) {
      body {
        padding: 16px 10px;
      }

      .header,
      .content,
      .footer {
        padding-left: 18px;
        padding-right: 18px;
      }

      .otp-code {
        font-size: 30px;
        letter-spacing: 0.12em;
      }
    }
  </style>
</head>
<body>
  <div class="email-card">
    <div class="header">
      <div class="brand">
        <div class="logo">F</div>
        <div>
          <div class="brand-name">FormNest</div>
          <div class="brand-copy">Secure form infrastructure</div>
        </div>
      </div>
    </div>

    <div class="content" style="padding: 28px 30px 30px;">
      <h1 style="font-size: 24px; line-height: 1.25; color: #111827; margin-bottom: 10px;">Verify your email, {{name}}</h1>
      <p style="color: #475569; font-size: 15px; margin-bottom: 20px;">Enter this one-time code on the FormNest verification page to activate your account.</p>

      <div class="otp-box" style="margin: 26px 0 22px; padding: 24px; border-radius: 16px; background: #f8fafc; border: 1px solid #dbe4f0; text-align: center;">
        <div class="otp-label" style="margin-bottom: 10px; color: #64748b; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;">Verification code</div>
        <div class="otp-code" style="color: #312e81; font-family: monospace, sans-serif; font-size: 38px; font-weight: 800; letter-spacing: 0.18em; display: block; margin: 10px 0;">{{verificationOtp}}</div>
      </div>

      <div class="expiry" style="margin-top: 16px; padding: 13px 14px; border-radius: 12px; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; font-size: 14px;">
        This code expires in <strong>{{expiresIn}}</strong>. If you did not sign up for FormNest, you can ignore this email.
      </div>
    </div>

    <div class="footer" style="border-top: 1px solid #edf1f7; padding: 18px 30px 24px; color: #64748b; font-size: 12px;">
      FormNest will never ask for this code outside the verification screen.
    </div>
  </div>
</body>
</html>
