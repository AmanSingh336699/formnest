<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>You're invited · FormNest Team</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(135deg, #F1F5F9 0%, #E6EDF4 100%);
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;
      line-height: 1.5;
      padding: 2rem 1rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* main card container */
    .invite-card {
      max-width: 620px;
      width: 100%;
      margin: 0 auto;
      background: #FFFFFF;
      border-radius: 2rem;
      box-shadow: 0 25px 45px -12px rgba(0, 0, 0, 0.2), 0 4px 8px -2px rgba(0, 0, 0, 0.03);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      overflow: hidden;
    }

    .card-inner {
      padding: 2.5rem 2rem;
    }

    /* header with brand */
    .brand-area {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 28px;
      padding-bottom: 12px;
      border-bottom: 2px solid #F1F5F9;
    }

    .icon-badge {
      background: #4F46E5;
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 1.25rem;
      box-shadow: 0 10px 15px -8px rgba(79, 70, 229, 0.3);
    }

    .icon-badge svg {
      width: 26px;
      height: 26px;
      color: white;
    }

    .brand-title h2 {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      background: linear-gradient(145deg, #0F172A, #1E2A44);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .brand-title span {
      font-size: 0.7rem;
      font-weight: 500;
      color: #5B6E8C;
      letter-spacing: 0.3px;
    }

    /* invitation main block */
    .invite-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #EEF2FF;
      padding: 6px 14px;
      border-radius: 40px;
      margin-bottom: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      color: #4F46E5;
    }

    .main-heading {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.2;
      color: #0A0F1C;
      margin: 0.25rem 0 0.5rem 0;
      letter-spacing: -0.3px;
    }

    .highlight-name {
      background: linear-gradient(120deg, #EFF6FF 0%, #E0E7FF 100%);
      color: #1E40AF;
      padding: 0.1rem 0.5rem;
      border-radius: 40px;
      display: inline-block;
      font-weight: 700;
    }

    .invite-message {
      background: #F9FCFF;
      border-radius: 1.25rem;
      padding: 1rem 1.25rem;
      margin: 1.25rem 0 0.75rem;
      border-left: 5px solid #4F46E5;
      font-size: 1rem;
      color: #1E293B;
      font-weight: 500;
    }

    .invite-message strong {
      color: #4F46E5;
      font-weight: 800;
    }

    .team-cta {
      margin: 1.75rem 0 1.5rem;
    }

    /* stylish accept button */
    .accept-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: linear-gradient(105deg, #059669 0%, #10B981 100%);
      color: white;
      font-weight: 700;
      font-size: 1rem;
      padding: 0.85rem 2.2rem;
      border-radius: 60px;
      text-decoration: none;
      box-shadow: 0 12px 20px -12px rgba(16, 185, 129, 0.4);
      transition: all 0.25s ease;
      letter-spacing: 0.3px;
      border: none;
    }

    .accept-btn:hover {
      background: linear-gradient(105deg, #047857 0%, #059669 100%);
      transform: translateY(-2px);
      box-shadow: 0 18px 28px -12px rgba(5, 150, 105, 0.45);
    }

    .accept-btn:active {
      transform: translateY(1px);
    }

    /* link fallback */
    .link-fallback {
      background: #F8FAFE;
      border-radius: 1.25rem;
      padding: 1rem 1.2rem;
      margin: 1.25rem 0 1rem;
      border: 1px solid #E9EDF2;
    }

    .link-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #5A6E8C;
      letter-spacing: 0.4px;
      margin-bottom: 12px;
    }

    .link-url {
      background: #FFFFFF;
      padding: 12px 14px;
      font-size: 0.78rem;
      font-family: 'SF Mono', 'Menlo', monospace;
      word-break: break-all;
      border-radius: 1rem;
      border: 1px solid #E2E8F0;
      color: #1F2A44;
    }

    /* expiry card with 7 days highlight */
    .expiry-container {
      background: #FFF7ED;
      border-radius: 1rem;
      padding: 0.9rem 1rem;
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 1rem 0 1.5rem;
      border: 1px solid #FFE4C4;
    }

    .expiry-icon {
      font-size: 1.7rem;
    }

    .expiry-text {
      font-size: 0.85rem;
      font-weight: 500;
      color: #9A3412;
    }

    .expiry-text strong {
      font-weight: 800;
      background: #FFE8D6;
      padding: 0.15rem 0.35rem;
      border-radius: 20px;
      color: #C2410C;
    }

    /* divider and footer */
    .divider-soft {
      border: none;
      height: 1px;
      background: radial-gradient(circle, #CBD5E1 30%, transparent);
      margin: 2rem 0 1rem;
    }

    .footer-note {
      text-align: center;
      font-size: 0.73rem;
      color: #6C7A92;
      line-height: 1.5;
    }

    .footer-note a {
      color: #4F46E5;
      text-decoration: none;
      font-weight: 500;
    }

    .footer-note a:hover {
      text-decoration: underline;
    }

    /* fully responsive */
    @media (max-width: 560px) {
      body {
        padding: 1rem;
      }
      .card-inner {
        padding: 1.75rem 1.25rem;
      }
      .main-heading {
        font-size: 1.65rem;
      }
      .accept-btn {
        width: 100%;
        justify-content: center;
        padding: 0.8rem 1rem;
      }
      .brand-title h2 {
        font-size: 1.45rem;
      }
      .link-url {
        font-size: 0.68rem;
        padding: 8px 12px;
      }
    }

    @media (max-width: 450px) {
      .card-inner {
        padding: 1.3rem 1rem;
      }
      .main-heading {
        font-size: 1.45rem;
      }
      .invite-message {
        font-size: 0.9rem;
        padding: 0.9rem;
      }
    }

    /* fade-in animation */
    @keyframes slideFade {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .invite-card {
      animation: slideFade 0.45s cubic-bezier(0.2, 0.9, 0.4, 1.1) forwards;
    }
  </style>
</head>
<body>
  <div class="invite-card">
    <div class="card-inner">
      
      <!-- Brand header -->
      <div class="brand-area">
        <div class="icon-badge">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" width="26" height="26">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div class="brand-title">
          <h2>FormNest</h2>
          <span>collaborative workspace</span>
        </div>
      </div>

      <!-- invitation chip -->
      <div class="invite-badge">
        <span>✨</span> TEAM INVITATION
      </div>

      <!-- main heading -->
      <div class="main-heading">
        You’re invited to <span style="color:#4F46E5;">FormNest</span>
      </div>

      <!-- personalized inviter message -->
      <div class="invite-message">
        🪶 <strong>{{inviterName}}</strong> has invited you to join their team on <strong>FormNest</strong>.
        Collaborate on forms, manage submissions, and build powerful workflows together.
      </div>

      <div class="team-cta">
        <a href="{{acceptUrl}}" class="accept-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Accept Invitation
        </a>
      </div>

      <!-- fallback link -->
      <div class="link-fallback">
        <div class="link-header">
          <span>🔗</span> MANUAL ACCEPT LINK
        </div>
        <div class="link-url">
          {{acceptUrl}}
        </div>
        <div style="font-size: 0.7rem; margin-top: 8px; color: #5E7188;">
          If the button doesn’t work, copy & paste this link into your browser.
        </div>
      </div>

      <!-- expiry highlight with 7 days -->
      <div class="expiry-container">
        <div class="expiry-icon">⏰</div>
        <div class="expiry-text">
          This invitation is valid for <strong>7 days</strong>. Accept before it expires to join the team workspace.
        </div>
      </div>

      <hr class="divider-soft">

      <div class="footer-note">
        🔒 If you didn’t expect this invitation, you can safely ignore this email.<br>
        Need help? <a href="#">Contact support</a> — © 2025 FormNest · secure team collaboration
      </div>
    </div>
  </div>
</body>
</html>